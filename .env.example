# Server
PORT=8080
ROOT_PATH=

# Build-history persistence (Phase 3). Leave empty to disable — builds still work,
# they just aren't recorded. Inside docker-compose the app uses the bundled db:
#   postgresql+psycopg://postgres:postgres@db:5432/builder
# Local dev against SQLite also works: sqlite:///./builds.db
DATABASE_URL=

# Build-result cache (Phase 3). Leave empty to disable — identical requests then
# always rebuild. Inside docker-compose the app uses the bundled redis:
#   redis://cache:6379/0
REDIS_URL=
# Seconds a cached ZIP is served before the request builds fresh again.
BUILD_CACHE_TTL=3600

# LLM — OpenAI-compatible endpoint.
# Local dev with Ollama (default): http://localhost:11434/v1
# Inside docker-compose the app reaches Ollama at http://ollama:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Model tag as pulled by Ollama. qwen2.5:1.5b fits a ~3.5 GB Docker VM;
# qwen2.5:3b / phi3:3.8b need ~6-8 GB allocated to Docker.
LLM_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.1
